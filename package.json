{
  "name": "@pepicons/monorepo",
  "private": true,
  "type": "module",
  "version": "3.1.6",
  "author": "Luca Ban - Mesqueeb",
  "funding": "https://github.com/sponsors/mesqueeb",
  "license": "CREATIVE COMMONS ATTRIBUTION 4.0 INTERNATIONAL LICENSE",
  "scripts": {
    "dev:pepicons.com": "pnpm run _warn && pnpm --filter pepicons.com dev",
    "dev:vue": "pnpm run _warn && pnpm --filter @pepicons/vue dev",
    "deploy:pepicons.com": "pnpm run build:pepicons.com && pnpm --filter pepicons.com run deploy",
    "build": "pnpm run _prepare-pepicons && pnpm --filter pepicons build && pnpm --filter @pepicons/vue build",
    "build:pepicons.com": "pnpm --filter pepicons.com build",
    "release": "pnpm run build && bumpp package.json packages/*/package.json --no-push --all && pnpm --filter pepicons --filter @pepicons/vue publish --access public && git push --follow-tags && gh release create $(git describe --tags --abbrev=0) --generate-notes --notes \"$(git log --pretty='- %s  %h' $(git describe --tags --abbrev=0 HEAD~1 2>/dev/null || git rev-list --max-parents=0 HEAD)..HEAD~1)\"",
    "dep:update-all:soft": "ncu --workspaces --root --target minor -u",
    "dep:update-all": "pnpm run dep:update-all:soft && pnpm install",
    "dep:check-for-updates": "ncu --workspaces --root",
    "dep:reinstall-all:soft": "pnpm exec del-cli node_modules packages/*/node_modules projects/*/node_modules && pnpm install",
    "dep:reinstall-all:hard": "del-cli pnpm-lock.yaml && pnpm run dep:reinstall-all:soft",
    "prettier:fix-all": "prettier --write \"{packages,projects}/*/src/**/*.{vue,ts}\"",
    "_prepare-pepicons": "tsx ./scripts/preparePepicons.ts",
    "_warn": "echo \"BE SURE TO RUN pnpm run build ONCE! otherwise the dev server might not launch\""
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.4.1"
  },
  "bugs": {
    "url": "https://github.com/cycraft/pepicons/issues"
  },
  "homepage": "https://github.com/cycraft/pepicons#readme",
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^18.19.130",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@viteplay/plugin": "^0.2.9",
    "@viteplay/vue": "^0.2.9",
    "archiver": "^5.3.2",
    "babel-eslint": "^10.1.0",
    "bumpp": "^12.3.0",
    "case-anything": "^2.1.13",
    "cpy": "^10.1.0",
    "del": "^7.1.0",
    "del-cli": "^5.1.0",
    "esbuild": "^0.17.19",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-vue": "^9.33.0",
    "exec-sh": "^0.4.0",
    "fast-glob": "^3.3.3",
    "fast-sort": "^3.4.1",
    "fs-extra": "^11.4.1",
    "inquirer": "^9.3.8",
    "is-what": "^4.1.16",
    "mri": "^1.2.0",
    "npm-check-updates": "^16.14.20",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^3.2.4",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^5.3.1",
    "rollup-plugin-esbuild": "^5.0.0",
    "sass": "^1.105.1",
    "svgo": "^3.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vue": "^3.5.43",
    "vue-intellisense": "^1.0.3",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.4.1"
}
